# --- Firebase (optionnel) -------------------------------------------------
# Sans ces variables, le site fonctionne en MODE DÉMONSTRATION LOCAL
# (persistance dans le navigateur, aucune sécurité réelle).
# Renseignez-les (fichier .env.local ou variables Netlify) pour activer
# Firebase Authentication + Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
